# Admin panel (/admin) — required to log in and publish changes.
# Set these in Vercel: Project Settings → Environment Variables.

# Email required alongside the password on the /admin login screen.
# Set the real value in Vercel, never here — this file is committed and public.
ADMIN_EMAIL=

# Password for /admin login. Pick something long and random.
# Set the real value in Vercel (Project Settings → Environment Variables),
# never here — this file is committed and public.
ADMIN_PASSWORD=

# A GitHub Personal Access Token (fine-grained, scoped to this repo only)
# with "Contents: Read and write" permission.
GITHUB_TOKEN=

# owner/repo that the admin panel commits to.
GITHUB_REPO=alamdarmanafov/bepositivenews

# Branch the admin panel commits to — must be the branch Vercel deploys from.
# This repo currently only has claude/yeni-sayt-quraq-8ya9y2 (no main branch yet).
GITHUB_CONTENT_BRANCH=claude/yeni-sayt-quraq-8ya9y2

# Public site origin, used for canonical URLs, sitemap, OG tags, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://bepositivenews.example
